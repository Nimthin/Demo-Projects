from instagrapi import Client
import pandas as pd
from datetime import datetime
from dotenv import load_dotenv
import os

# --- LOAD .env ---
load_dotenv()
USERNAME_LOGIN = os.getenv("IG_USERNAME")
PASSWORD_LOGIN = os.getenv("IG_PASSWORD")

# --- CONFIGURATION ---
USERNAME = "mastercard"  # Target username
POST_LIMIT = 1000         # Number of recent posts to scrape

# Login
cl = Client()
cl.login(USERNAME_LOGIN, PASSWORD_LOGIN)
cl.dump_settings("insta_session.json")

user_id = cl.user_id_from_username(USERNAME)

# Fetch recent posts
medias = cl.user_medias(user_id, amount=POST_LIMIT)

if not medias:
    print("No posts found for this user.")
    exit()

# Media type map
MEDIA_TYPE_MAP = {
    1: "Image",
    2: "Video",
    8: "Carousel"
}

all_posts = []

for media in medias:
    caption = media.caption_text or ""
    hashtags = [tag.strip("#") for tag in caption.split() if tag.startswith("#")]
    mentions = [tag.strip("@") for tag in caption.split() if tag.startswith("@")]
    location = media.location_name if hasattr(media, "location_name") else None
    media_type_str = MEDIA_TYPE_MAP.get(media.media_type, str(media.media_type))

    post_data = {
        "url": f"https://www.instagram.com/p/{media.code}/",
        "likes": media.like_count,
        "comments": media.comment_count,
        "date": media.taken_at.strftime("%Y-%m-%d %H:%M"),
        "caption": caption,
        "media_type": media_type_str,
        "video_duration": getattr(media, "video_duration", None),
    }

    for i, tag in enumerate(hashtags, start=1):
        post_data[f"hashtag_{i}"] = tag
    for i, mention in enumerate(mentions, start=1):
        post_data[f"mention_{i}"] = mention

    all_posts.append(post_data)

# Create DataFrame and sort by date (descending)
df = pd.DataFrame(all_posts)
df['date'] = pd.to_datetime(df['date'])  # Convert to datetime for proper sorting
df = df.sort_values('date', ascending=False)
df['date'] = df['date'].dt.strftime("%Y-%m-%d %H:%M")  # Convert back to string if preferred

# Save to Excel
now_str = datetime.now().strftime("%Y%m%d_%H%M%S")
filename = f"instagram_post_data_{now_str}.xlsx"
df.to_excel(filename, index=False)
print(f"Data saved to {filename} (sorted by date, newest first)")
